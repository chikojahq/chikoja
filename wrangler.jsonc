{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chikoja",
  "account_id": "cbaf7c8b254ee4af435b9d6e32d2c6f1",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "chikoja.ir", "custom_domain": true },
    { "pattern": "*.chikoja.ir/*", "zone_name": "chikoja.ir" }
  ]
}
