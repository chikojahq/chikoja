{
  "name": "chikoja",
  "version": "1.0.0",
  "private": true,
  "description": "Static archive page for chikoja.ir, served by a Cloudflare Worker.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build-data.mjs && node scripts/build-site.mjs && node scripts/build-packs.mjs",
    "build:site": "node scripts/build-site.mjs && node scripts/build-packs.mjs",
    "test": "node --test --test-concurrency=1 tests/",
    "screenshots": "node tests/screenshots.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "osm-pbf-parser": "^2.3.0",
    "vazirmatn": "^33.0.3",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "workerd@1.20261023.1": true
  }
}
